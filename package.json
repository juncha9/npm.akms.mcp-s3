{
    "name": "@akms/mcp-s3",
    "version": "0.3.2",
    "description": "MCP server for object CRUD in one AWS S3 or S3-compatible bucket.",
    "keywords": [
        "mcp",
        "s3",
        "object-storage",
        "model-context-protocol"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/juncha9/npm.akms.mcp-s3.git"
    },
    "homepage": "https://github.com/juncha9/npm.akms.mcp-s3#readme",
    "bugs": {
        "url": "https://github.com/juncha9/npm.akms.mcp-s3/issues"
    },
    "type": "module",
    "main": "./lib/index.cjs",
    "module": "./lib/index.js",
    "types": "./lib/index.d.ts",
    "bin": {
        "akms-mcp-s3": "lib/cli.js"
    },
    "exports": {
        ".": {
            "import": {
                "types": "./lib/index.d.ts",
                "default": "./lib/index.js"
            },
            "require": {
                "types": "./lib/index.d.cts",
                "default": "./lib/index.cjs"
            }
        }
    },
    "files": [
        "lib",
        "README.md",
        "CHANGELOG.md",
        "LICENSE.md"
    ],
    "engines": {
        "node": ">=22"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "prepublishOnly": "node scripts/release-guard.mjs",
        "build": "tsc --noEmit && rimraf ./lib && tsup",
        "watch": "tsc --noEmit && tsup --watch",
        "dev": "tsx ./src/cli.ts",
        "start": "node ./lib/cli.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "prepack": "npm run build",
        "pretest": "npm run build"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "3.1152.0",
        "@aws-sdk/credential-providers": "3.1152.0",
        "@smithy/node-http-handler": "4.12.1",
        "@modelcontextprotocol/sdk": "^1.30.1",
        "smol-toml": "1.9.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@types/node": "^24.19.0",
        "@vitest/coverage-v8": "^4.1.11",
        "rimraf": "^6.1.3",
        "tsup": "^8.5.1",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "vitest": "^4.1.11"
    }
}
